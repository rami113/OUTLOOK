{
  "name": "outlook-app",
  "version": "1.0.0",
  "main": "electron-main.js",
  "homepage": "./",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "build": "npm run react-build",
    "electron-build-win": "npm run react-build && electron-builder --win --publish never"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "node-fetch": "^2.6.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^24.0.0",
    "electron-builder": "^24.1.1"
  },
  "build": {
    "appId": "com.outlook.app",
    "productName": "OUTLOOK",
    "files": [
      "build/**/*",
      "electron-main.js",
      "node_modules/**/*",
      ".env"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "OUTLOOK.exe"
    }
  }
}
